[virtual=x86_64,multiboot] .bootstrap = {
  startup-x86 -D 8250.3f8.115200
  PATH=/proc/boot LD_LIBRARY_PATH=/proc/boot procnto-smp-instr
}
[+script] .script = {
  procmgr_symlink ../../proc/boot/libc.so /usr/lib/ldqnx-64.so.2
  display_msg FDSCRIPT START
  slogger2 &
  waitfor /dev/slog2 5
  /proc/boot/fdcrash
  display_msg FDCRASH RETURNED
  slog2info
  display_msg FDSCRIPT END
}
libc.so
libc.so.6
libgcc_s.so.1
slogger2
slog2info
fdcrash=/home/hatch/workspace/hackathons/qnx/flight-deck/runs/fdcrash-20261116-052015/fdcrash
